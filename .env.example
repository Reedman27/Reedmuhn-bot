# Copy this file to .env in the same folder as docker-compose.yml, then
# fill in the values below. Never commit the real .env - .gitignore already
# excludes it.
#   cp .env.example .env

# =====================================================================
# REQUIRED - docker compose refuses to start without these
# =====================================================================
# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=your_discord_bot_token
# Discord Developer Portal -> OAuth2 (used for WebUI login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Add this exact URL under OAuth2 -> Redirects in the Developer Portal:
#   https://YOUR-TAILSCALE-FUNNEL-DOMAIN/auth/discord/callback
# (LAN-only testing: http://YOUR-SERVER-IP:8490/auth/discord/callback)
DISCORD_REDIRECT_URI=

# =====================================================================
# WEBUI / NETWORK
# =====================================================================
# Set to 1 when the WebUI is behind HTTPS (Tailscale Funnel included);
# marks the session cookie Secure. Leave 0 for plain local/LAN use.
WEBUI_HTTPS_ONLY=0
# Set to 1 when the dashboard sits behind Tailscale Funnel or another reverse
# proxy so logs and login lockout see real client IPs. Only safe when clients
# can NOT reach port 8490 directly - pair it with WEBUI_BIND_ADDRESS=127.0.0.1.
WEBUI_TRUST_PROXY=0
# Host interface that publishes the dashboard (port 8490). Default: all
# interfaces. Use 127.0.0.1 behind a reverse proxy / SSH tunnel, or a
# VPN/LAN address to limit exposure.
WEBUI_BIND_ADDRESS=0.0.0.0

# =====================================================================
# BOT (optional)
# =====================================================================
# Restrict slash-command syncing to one server for fast testing. Leave blank
# to sync globally (can take up to an hour to propagate).
DEV_GUILD_ID=
# Also delete channel-feed rows older than N days. 0 = keep forever.
FEED_RETENTION_DAYS=0
# Log rotation (bytes per file / number of rotated files kept).
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# =====================================================================
# MUSIC / LAVALINK (optional)
# =====================================================================
# Music is OFF unless this is set. Shared secret between the bot and Lavalink:
# any long random string, e.g.  openssl rand -hex 24
# To run the bundled Lavalink too:  docker compose --profile music up -d
# (or add COMPOSE_PROFILES=music below so a plain `docker compose up -d` does it).
LAVALINK_PASSWORD=
# Only change these three when pointing at a Lavalink node OUTSIDE the
# bundled docker-compose setup.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_SECURE=0
MUSIC_SEARCH_PLATFORM=youtube
MUSIC_LYRICS_PLATFORM=lrclib
MUSIC_MAX_QUEUE=1000
MUSIC_MAX_PLAYLISTS=10
MUSIC_MAX_TRACKS=500
# Seconds before an idle player is cleaned up.
MUSIC_INACTIVE_CLEANUP=600

# =====================================================================
# INTEGRATIONS (optional)
# =====================================================================
# Twitch live notifications. Leave blank to disable.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# =====================================================================
# DOCKER IMAGES (optional - only if you publish/pull your own images)
# =====================================================================
# DOCKERHUB_USERNAME=reedman27
# LAVALINK_IMAGE=docker.io/reedman27/reedmuhn-bot:lavalink

# =====================================================================
# NOT NEEDED - compose sets these for you
# =====================================================================
# DB_PATH=/app/data/bot.db and REDIS_URL=redis://redis:6379/0 are set inside
# docker-compose.yml. Only override them when running outside compose.

# =====================================================================
# COGS / BOOT (optional)
# =====================================================================
# Channel ID where the bot posts a report on every start: each cog file it
# loaded (with the error if one failed). Use a private staff channel.
BOOT_LOG_CHANNEL_ID=
# Cogs to skip, comma separated - by file name or folder.file
# (e.g. DISABLED_COGS=music,fun.polls). Leave empty to load everything.
DISABLED_COGS=
