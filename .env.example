# Copy this file to .env in the same folder as docker-compose.yml, then
# fill in the values below. Never commit the real .env - .gitignore already
# excludes it.

# --- Required ---
DISCORD_TOKEN=your_discord_bot_token
WEBUI_PASSWORD=change-me

# --- Optional core ---
# Restrict slash-command syncing to one server for faster testing. Leave
# blank to sync globally (can take up to an hour to propagate on Discord's end).
DEV_GUILD_ID=
# Set to "true" once the WebUI is behind real HTTPS (e.g. a reverse proxy).
# Leave unset/false for plain local/LAN use.
WEBUI_HTTPS_ONLY=

# --- Music / Lavalink ---
# Shared secret between the bot and the bundled Lavalink container. Defaults
# to "youshallnotpass" if unset, which is fine since Lavalink is only
# reachable on the internal compose network, not the host.
LAVALINK_PASSWORD=change-this-secret
# These three only need changing if you're pointing at a Lavalink node
# outside the bundled docker-compose setup.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_SECURE=
MUSIC_SEARCH_PLATFORM=youtube
MUSIC_LYRICS_PLATFORM=lrclib
MUSIC_MAX_QUEUE=1000
MUSIC_MAX_PLAYLISTS=10
MUSIC_MAX_TRACKS=500
MUSIC_INACTIVE_CLEANUP=600

# --- Redis (fast/temporary state - cooldowns, rate limits, webui<->bot wake signals) ---
# The bundled docker-compose.yml sets this for you automatically - only set
# it yourself if you're running Redis somewhere other than the compose setup.
REDIS_URL=redis://redis:6379/0

# --- Optional integrations ---
# Twitch live-notification feature. Leave blank to disable it.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Optional advanced ---
DB_PATH=data/bot.db
LOG_MAX_BYTES=
LOG_BACKUP_COUNT=
